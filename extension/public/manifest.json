{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "Progressive Friction",
  "version": "0.1.0",
  "description": "Interrupt unwanted browsing habits with progressive math challenges and intentional friction.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Progressive Friction"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-loader.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content-main.js",
        "assets/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
